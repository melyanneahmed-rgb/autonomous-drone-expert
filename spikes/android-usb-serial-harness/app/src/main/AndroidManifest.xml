<?xml version="1.0" encoding="utf-8"?>
<!--
  M1C Android USB serial hardware harness - SPIKE.
  NO permissions are declared: USB host access uses runtime UsbManager permission,
  and this harness needs no INTERNET, Bluetooth, location, or storage permission.
  No background service. Only the launcher activity is exported (required for launch).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.hardware.usb.host"
        android:required="true" />

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.M1C">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
